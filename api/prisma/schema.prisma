// AchoFlores — modelo de datos
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MERCHANT
  COURIER
  ADMIN
}

enum StallStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  DNI
  RUC
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(CUSTOMER)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  consentAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  stall         Stall?
  passwordResets PasswordReset[]
  checkouts     Checkout[]
}

// HU-21: token de un solo uso, guardado como hash SHA-256, vence en 30 minutos.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Stall {
  id              String       @id @default(cuid())
  ownerId         String       @unique
  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  number          String       @unique
  pavilion        String
  schedule        String
  documentType    DocumentType
  documentNumber  String
  status          StallStatus  @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  products        Product[]
  orders          Order[]

  @@index([status])
}

model Product {
  id          String   @id @default(cuid())
  stallId     String
  stall       Stall    @relation(fields: [stallId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String
  occasion    String?
  priceCents  Int
  // HU-07: precio unitario por mayor a partir de una cantidad mínima
  wholesalePriceCents Int?
  wholesaleMinQty     Int?
  stock       Int
  active      Boolean  @default(true)
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([stallId])
  @@index([category])
}

// Almacenamiento de imágenes de respaldo cuando Cloudinary no está configurado.
model ImageBlob {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CARD
  YAPE
  PLIN
}

enum CheckoutStatus {
  PENDING_PAYMENT
  PAID
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

// Una compra del cliente (un solo pago) que agrupa los pedidos de varios puestos.
model Checkout {
  id               String         @id @default(cuid())
  customerId       String
  customer         User           @relation(fields: [customerId], references: [id])
  status           CheckoutStatus @default(PENDING_PAYMENT)
  fulfillment      Fulfillment
  district         String?
  address          String?
  phone            String
  deliveryFeeCents Int            @default(0)
  itemsTotalCents  Int
  totalCents       Int
  paymentMethod    PaymentMethod?
  chargeId         String?        @unique
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  orders           Order[]

  @@index([customerId])
}

// Pedido de un puesto dentro de una compra (HU-15: el comerciante solo ve los suyos).
model Order {
  id            String       @id @default(cuid())
  checkoutId    String
  checkout      Checkout     @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  stallId       String
  stall         Stall        @relation(fields: [stallId], references: [id])
  status        OrderStatus  @default(PENDING_PAYMENT)
  subtotalCents Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         OrderItem[]
  events        OrderEvent[]

  @@index([stallId, status])
}

// El precio se copia al detalle: editar el producto no cambia pedidos ya hechos (HU-06).
model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  name           String
  unitPriceCents Int
  quantity       Int
}

// Historial de estados con fecha y hora (HU-15, HU-17).
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}
